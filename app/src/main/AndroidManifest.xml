<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screen-time numbers, app timers and the weekly review all come from the system usage log. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- A launcher has to see every installed app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- "Uninstall" in the long-press menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- "Your weekly review is ready". -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional calendar section on the home screen. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Swipe down on the home screen to open notifications. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Setup → "Keep Focus running": lets the app ask, once, to be left out of battery optimisation.
         Some phones kill the home screen for memory several times a day; the system then shows
         its own launcher for the second Focus takes to come back. Nothing runs in the background. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".FocusApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Focus">

        <!-- The launcher itself: home page + app drawer. -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Shows up in the app list as "Focus Settings", so settings stay reachable from any launcher.
             Its own task affinity is what makes that true: sharing the home task's, a launcher
             start (NEW_TASK) only brought the home screen forward and never opened this. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_label"
            android:taskAffinity="com.focus.launcher.settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Full-screen "time's up" wall. Lives in its own task so it can sit on top of the limited app. -->
        <activity
            android:name=".BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="false"
            android:taskAffinity="com.focus.launcher.block" />

        <service
            android:name=".service.FocusAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Optional. Only the key to "which player is active and what is it playing" for the music
             section; the service reads no notification and lets go of its binding at once. -->
        <service
            android:name=".service.MediaListener"
            android:exported="true"
            android:label="@string/media_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.WeeklyReviewReceiver"
            android:exported="false" />
    </application>
</manifest>
