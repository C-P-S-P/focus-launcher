    <string name="settings_bottom_left">Bottom left</string>
    <string name="settings_bottom_right">Bottom right</string>
    <string name="settings_bottom_left_shortcut">Bottom left shortcut</string>
    <string name="settings_bottom_right_shortcut">Bottom right shortcut</string>
    <string name="settings_shortcut_phone">Phone</string>
