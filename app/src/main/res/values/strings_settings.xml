    <!-- Fast apps -->
    <!-- “Move to fast apps” is an item of the app menu in the drawer: keep it the same wording. -->
    <string name="settings_fast_apps_note">The apps listed on your home screen, in this order. You can also add one from the app drawer: long-press it, then “Move to fast apps”.</string>
    <string name="settings_remove">Remove</string>
    <string name="settings_add_app">Add an app</string>
