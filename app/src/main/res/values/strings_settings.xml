    <!-- Welcome screen, shown once on the first start. -->
    <string name="settings_welcome_tagline">Reclaim your time.\nSpend it touching some grass.</string>
    <string name="settings_welcome_intro">No icons. No colour. No feed.\nTips on the home screen show you around.</string>
    <!-- Above the row that picks the app a swipe right opens. -->
    <string name="settings_welcome_swipe_right">Swipe right opens. Which app?</string>
    <string name="settings_welcome_start">Start</string>
    <string name="settings_welcome_setup_first">Set up Focus first</string>

