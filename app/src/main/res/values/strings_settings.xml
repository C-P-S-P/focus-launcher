    <string name="settings_gestures">Gestures</string>
    <string name="settings_gestures_summary">Swipes, double tap, keyboard in the drawer</string>
    <string name="settings_appearance">Appearance</string>
    <string name="settings_appearance_summary">Black or white, typeface, text size</string>
    <!-- Section header over app timers and the weekly review: the features that help you focus. -->
    <string name="settings_section_focus">Focus</string>
    <string name="settings_app_timers">App timers</string>
    <string name="settings_app_timers_summary">Daily limits that lock social apps and games</string>
    <string name="settings_weekly_review">Weekly review</string>
    <string name="settings_weekly_review_summary">A look back at the end of every week</string>
    <string name="settings_about">About</string>

    <!-- About -->
    <string name="settings_about_welcome">Welcome screen and tips</string>
    <string name="settings_about_welcome_summary">Shows the tips on the home screen again, one at a time.</string>
    <!-- %1$s is the version number, e.g. "1.4". -->
    <string name="settings_about_version" translatable="false">Focus %1$s</string>
    <string name="settings_about_text">A launcher with nothing to look at. No icons, no colour, no feed: the time, the few apps you chose, and an honest picture of where your day is going.</string>
    <string name="settings_about_privacy">Privacy</string>
    <string name="settings_about_privacy_text">Focus has no internet permission, so nothing it knows can leave this phone. Screen time is read from Android\'s own usage log and stored only in the app\'s private storage. The timer service sees the name of the app in front and nothing else; it cannot read what is on your screen.</string>
    <string name="settings_about_tips">Tips</string>
    <string name="settings_about_tip_drawer">Swipe left on the home screen for all apps.</string>
    <string name="settings_about_tip_app_menu">Long-press any app for its menu: timer, rename, hide, fast apps.</string>
    <string name="settings_about_tip_settings">Long-press empty space on the home screen to open these settings.</string>
    <string name="settings_about_tip_corners">Long-press a corner shortcut to change it.</string>
    <string name="settings_about_tip_clock">Tap the clock for alarms, the date for your calendar, the day bar for details.</string>

    <!-- Setup: the system switches Focus depends on. -->
    <string name="settings_setup_intro">Three switches make Focus work. Tap one to open the right system screen, flip it, and come back.</string>
    <string name="settings_setup_required">Required</string>
    <string name="settings_setup_launcher">1 · Default launcher</string>
    <string name="settings_setup_launcher_summary">Makes Focus the screen you land on when you press Home.</string>
    <string name="settings_setup_done">Done</string>
    <!-- Action: make Focus the default launcher. -->
    <string name="settings_setup_set">Set</string>
    <string name="settings_setup_usage">2 · Usage access</string>
    <string name="settings_setup_usage_summary">Lets Focus measure screen time: the day bar, app timers and the weekly review all depend on it.</string>
    <!-- State: the permission is granted. -->
    <string name="settings_setup_allowed">Allowed</string>
    <!-- Action: ask for the permission. -->
    <string name="settings_setup_allow">Allow</string>
    <string name="settings_setup_timer_service">3 · Focus timer service</string>
    <!-- %1$s is the name the service has in Android's accessibility settings (accessibility_label). -->
    <string name="settings_setup_timer_service_summary">An accessibility service that notices which app is in front, so an app can be locked the moment its time runs out. It cannot read your screen. Find “%1$s” under installed or downloaded apps.</string>
    <string name="settings_setup_turn_on">Turn on</string>
    <!-- Tapping the note opens App info. The path names Android's own screens and menu items. -->
    <string name="settings_setup_restricted">Switch greyed out, or “restricted setting”? Open App info → ⋮ (top right) → Allow restricted settings, then try again.  Open App info  →</string>
    <string name="settings_setup_optional">Optional</string>
    <string name="settings_setup_notifications">Notifications</string>
    <string name="settings_setup_notifications_summary">Only used for one thing: telling you the weekly review is ready.</string>
    <string name="settings_setup_calendar">Calendar section</string>
    <string name="settings_setup_calendar_summary">This week at a glance and your next events, on the home screen.</string>
    <string name="settings_setup_calendar_added">Calendar added to your home screen</string>

    <!-- Home screen -->
    <string name="settings_clock">Clock</string>
    <!-- Row that picks the clock style. -->
    <string name="settings_style">Style</string>
    <string name="settings_clock_split_summary">The clock on the left, one section on the right, a single line between them.</string>
    <string name="settings_clock_ring_summary">The clock inside a circle.</string>
    <string name="settings_clock_plain_summary">The clock as plain text.</string>
    <string name="settings_clock_style">Clock style</string>
    <!-- What the right half of the split clock shows. -->
    <string name="settings_next_to_clock">Next to the clock</string>
    <string name="settings_next_to_clock_summary">What the right half shows. It is not repeated further down. Long-pressing it on the home screen gets you here too.</string>
    <string name="settings_ring_shows">Ring shows</string>
    <string name="settings_ring_battery_summary">A full circle is a full battery.</string>
    <string name="settings_ring_day_summary">The circle fills up as the day passes.</string>
    <string name="settings_show_battery">Show the battery level</string>
    <string name="settings_clock_tap">Tap on the clock</string>
    <string name="settings_clock_tap_summary">Opens an app of your choice, or alarms, calendar, screen time. Long-pressing the clock gets you here too.</string>
    <string name="settings_time_format">Time format</string>
    <string name="settings_show_date">Show the date</string>
    <string name="settings_show_seconds">Show seconds</string>
    <string name="settings_show_seconds_summary">The clock redraws every second while the home screen is on.</string>
    <string name="settings_sections">Sections</string>
    <string name="settings_calendar">Calendar</string>
    <string name="settings_calendar_summary">Your next events, from one calendar. Emoji in titles are left out.</string>
    <string name="settings_calendar_to_show">Calendar to show</string>
    <string name="settings_calendar_to_show_summary">Only one is shown at a time. Search the list to find the one you want.</string>
    <!-- Value of "Calendar to show": all calendars together. -->
    <string name="settings_calendar_all">All</string>
    <string name="settings_calendar_none_found">None found</string>
    <string name="settings_calendar_work_blocked">Calendars inside your Work profile are not listed: the organisation that manages it does not let other apps read them, and Focus respects that. If you share your work calendar with a personal Google account, it shows up here like any other calendar.</string>
    <string name="settings_week_strip">Week strip</string>
    <string name="settings_week_strip_summary">Monday to Sunday with today marked, above the events.</string>
    <string name="settings_music">Music</string>
    <string name="settings_music_summary">Previous, play or pause, next, in words. It can name the song if you allow it notification access.</string>
    <string name="settings_music_auto_hide">Hide it while nothing is playing</string>
    <string name="settings_music_auto_hide_summary">The section comes with the music and leaves a minute after it stops. Off: it is always there.</string>
    <string name="settings_music_app">Music app</string>
    <string name="settings_music_app_summary">Opens when you tap the section and nothing is playing. Long-pressing the section gets you here too.</string>
    <!-- Value of "Music app" when none is chosen yet: tapping the section asks which app. -->
    <string name="settings_music_app_ask">Asks first</string>
    <string name="settings_note">Note</string>
    <string name="settings_note_summary">A few lines of your own, always in sight. Tap them on the home screen to write.</string>
    <string name="settings_notes_app">Notes app</string>
    <string name="settings_notes_app_summary">A word next to the note\'s title that opens it. Your own lines stay on the home screen either way.</string>
    <string name="settings_fast_apps">Fast apps</string>
    <!-- %1$d is the most fast apps the home screen holds (MAX_FAVORITES). -->
    <plurals name="settings_fast_apps_summary">
        <item quantity="one">Up to %1$d app, one tap from the home screen.</item>
        <item quantity="other">Up to %1$d apps, one tap from the home screen.</item>
    </plurals>
    <!-- Size of the fast apps on the home screen. -->
    <string name="settings_favorite_size">Text size</string>
    <string name="settings_alignment">Alignment</string>
    <string name="settings_corner_shortcuts">Corner shortcuts</string>
