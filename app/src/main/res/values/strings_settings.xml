<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: the main list and every page under it, the welcome screen and the calendar picker. -->
<resources>
    <!-- Short values on the right of a settings row. -->
    <string name="settings_on">On</string>
    <string name="settings_off">Off</string>
    <string name="settings_none">None</string>

    <!-- Main page -->
    <string name="settings_setup">Setup</string>
    <string name="settings_setup_complete">Everything Focus needs is switched on.</string>
    <string name="settings_setup_incomplete">Finish these so timers and screen time work.</string>
    <string name="settings_setup_all_set">All set</string>
    <!-- Setup progress: %1$d steps done, out of %2$d (3). -->
    <string name="settings_setup_progress">%1$d of %2$d</string>
    <!-- Section header over the launcher settings (home screen, drawer, gestures, appearance). -->
    <string name="settings_section_launcher">Launcher</string>
    <string name="settings_home_screen">Home screen</string>
    <string name="settings_home_screen_summary">Clock, sections, fast apps, corner shortcuts</string>
    <string name="settings_app_drawer">App drawer</string>
    <string name="settings_app_drawer_summary">Keyboard, search, recently installed, hidden apps</string>
    <!-- How many apps the drawer lists. %1$d is the count. -->
