    <string name="settings_text_size_large">Large</string>
    <string name="settings_text_size_larger">Larger</string>
    <string name="settings_screen">Screen</string>
    <string name="settings_opening_apps">Opening apps</string>
    <!-- "Fast" and "System default" are the two choices (launch_animation_fast, launch_animation_system). -->
    <string name="settings_opening_apps_summary">Fast puts the app over the whole screen from its first frame. System default uses your phone\'s own animation.</string>
    <string name="settings_hide_status_bar">Hide the status bar</string>
    <string name="settings_hide_status_bar_summary">No notification icons on the home screen. Swipe down from the top edge to peek.</string>

    <!-- Gestures -->
    <string name="settings_gestures_note">Swiping left always opens the app drawer, and a long-press on empty space opens these settings.</string>
    <string name="settings_swipe_down_notifications">Swipe down for notifications</string>
    <string name="settings_swipe_up_search">Swipe up to search</string>
    <string name="settings_swipe_up_search_summary">Jumps to the drawer with the keyboard open.</string>
    <string name="settings_keyboard_with_drawer">Keyboard opens with the drawer</string>
    <string name="settings_keyboard_with_drawer_summary">Start typing the moment you swipe to your apps.</string>
    <string name="settings_swipe_right">Swipe right</string>
    <string name="settings_swipe_right_summary">Opens the app below, or the web search, like the page left of a stock home screen.</string>
    <string name="settings_double_tap_lock">Double tap to lock</string>
    <string name="settings_double_tap_lock_summary">Turns the screen off. Uses the Focus timer service.</string>
    <!-- Tapping the note opens Setup. -->
    <string name="settings_double_tap_service_off">The Focus timer service is off, so double tap cannot lock yet.  Open setup  →</string>
    <string name="settings_swipe_right_opens">Swipe right opens</string>
    <string name="settings_swipe_right_opens_summary">Any app, or the web search.</string>
    <string name="settings_web_search">Web search</string>

    <!-- App timers -->
    <!-- A daily limit. %1$s is a duration such as "30m". -->
    <string name="settings_per_day">%1$s a day</string>
    <string name="settings_app_timers_toggle_summary">Give distracting apps a daily allowance. When it is used up, Focus locks the app for the rest of the day.</string>
    <!-- Tapping the note opens Setup. -->
    <string name="settings_timers_no_usage_access">Timers cannot count anything until usage access is allowed.  Open setup  →</string>
    <!-- Tapping the note opens Setup. -->
    <string name="settings_timers_service_off">The Focus timer service is off: apps are only locked when opened from Focus, not while you are inside them.  Open setup  →</string>
    <string name="settings_automatic_limits">Automatic limits</string>
    <string name="settings_social_media">Social media</string>
    <string name="settings_social_media_summary">Feeds, social networks and dating apps. Not mail, browsers or messengers.</string>
    <string name="settings_social_media_dialog">Instagram, X, Reddit, Snapchat, LinkedIn, dating apps and the like.</string>
    <string name="settings_games">Games</string>
    <string name="settings_games_summary">Every app the Play Store lists as a game.</string>
    <string name="settings_games_dialog">Every app Android lists as a game.</string>
    <string name="settings_video">Video &amp; streaming</string>
    <string name="settings_video_summary">YouTube, Netflix and other video apps.</string>
    <string name="settings_video_dialog">YouTube, Netflix, Prime Video and anything else Android lists as a video app.</string>
    <string name="settings_limited_apps">Limited apps</string>
    <string name="settings_limited_apps_summary">See exactly which apps these cover, change one, or add your own.</string>
    <string name="settings_automatic_limits_note">An automatic limit only applies to apps without a limit of their own. Browsers, mail, messengers and other tools are never limited unless you add a timer yourself.</string>
    <string name="settings_when_time_is_up">When time is up</string>
    <string name="settings_allow_continue">Allow “continue for a few minutes”</string>
    <string name="settings_continue_options">Continue options</string>
    <!-- %1$s is a list of minute counts, e.g. "1, 5, 10". -->
    <string name="settings_continue_options_value">%1$s min</string>
    <!-- One of the continue choices. %1$d is a number of minutes. -->
    <string name="settings_continue_option">%1$d min</string>
    <string name="settings_continue_options_subtitle">Up to four are shown on the lock screen.</string>
    <string name="settings_allow_bypass">Allow “ignore the limit for today”</string>
    <string name="settings_strict_mode">Strict mode: with both off, a locked app stays locked until midnight.</string>
    <string name="settings_ask_after_bypass">Ask before every open after ignoring</string>
    <string name="settings_ask_after_bypass_summary">Ignoring a limit does not make the app free for the day: Focus still asks “open anyway?” each time.</string>
    <string name="settings_pause">Pause before continuing</string>
    <string name="settings_pause_summary">A short wait before the continue choices unlock. Time to change your mind.</string>
    <!-- %1$d is a number of seconds, in short form. -->
    <string name="settings_pause_value">%1$d s</string>
    <!-- One of the pause choices. %1$d is a number of seconds. -->
    <plurals name="settings_pause_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
    <string name="settings_heads_up">Heads-up before the limit</string>
    <!-- How long before the limit the warning comes. %1$s is a duration such as "5m". -->
    <string name="settings_heads_up_before">%1$s before</string>
    <string name="settings_preview_lock">Preview the lock screen</string>

    <!-- Limited apps -->
    <string name="settings_add_timer">Add a timer</string>
    <string name="settings_add_timer_summary">Any app can have one, not just social apps and games.</string>
    <string name="settings_with_daily_limit">With a daily limit</string>
    <!-- Where an app's limit comes from. -->
    <string name="settings_limit_own">Own limit</string>
    <string name="settings_limit_social">Social media, automatic</string>
    <string name="settings_limit_game">Game, automatic</string>
    <string name="settings_limit_video">Video, automatic</string>
    <string name="settings_no_limited_apps">No app is limited right now. Add a timer above, or set automatic limits for social apps and games on the previous page.</string>
    <string name="settings_excluded">Excluded from the automatic limits</string>
    <string name="settings_no_limit">No limit</string>
    <string name="settings_unsure">Not sure about these</string>
    <string name="settings_unsure_note">Android files these under “social”, a label it also gives to mail, browsers and messengers. Focus leaves them alone; tap one to give it a timer.</string>
    <!-- Value next to an app Focus is unsure about: tap it to give the app a timer. -->
    <string name="settings_add">Add</string>

    <!-- Weekly review -->
    <string name="settings_weekly_review_toggle_summary">At the end of each week Focus adds it all up: total time, which apps, which hours of the day, how often you went past a limit. Then it asks what you want to change.</string>
    <string name="settings_schedule">Schedule</string>
    <string name="settings_week_starts_on">Week starts on</string>
    <string name="settings_week_starts_monday">Monday</string>
    <string name="settings_week_starts_sunday">Sunday</string>
    <string name="settings_review_ready">Review is ready</string>
