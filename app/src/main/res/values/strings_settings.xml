    <string name="settings_fast_apps_full">That\'s the maximum. %1$d is plenty.</string>
    <string name="settings_add_fast_app">Add a fast app</string>

    <!-- App drawer -->
    <string name="settings_search">Search</string>
    <string name="settings_auto_keyboard">Open the keyboard right away</string>
    <string name="settings_auto_keyboard_summary">Start typing the moment you swipe to the drawer.</string>
    <string name="settings_auto_launch">Open when one app is left</string>
    <string name="settings_auto_launch_summary">Launches the app as soon as your search matches only one.</string>
    <string name="settings_list">List</string>
    <string name="settings_recent_installs">Recently installed</string>
    <string name="settings_recent_installs_summary">Apps installed in the last 24 hours, at the top.</string>
    <string name="settings_drawer_usage">Show timer progress</string>
    <!-- The example uses the short duration format (duration_minutes): time used / daily limit. -->
    <string name="settings_drawer_usage_summary">“12m / 30m” next to every app that has a daily limit.</string>
    <string name="settings_hidden_apps">Hidden apps</string>
    <!-- “Hide app” is an item of the app menu in the drawer: keep it the same wording. -->
    <string name="settings_hidden_apps_empty">Nothing is hidden. To hide an app, long-press it in the drawer and choose “Hide app”. Hidden apps stay installed and can be opened from here.</string>
    <string name="settings_open">Open</string>
    <string name="settings_unhide">Unhide</string>

    <!-- Appearance -->
    <string name="settings_black_and_white">Black and white</string>
    <string name="settings_theme">Theme</string>
    <string name="settings_theme_summary">Pure black saves battery on OLED screens.</string>
    <string name="settings_theme_black">Black</string>
    <string name="settings_theme_white">White</string>
    <string name="settings_typeface">Typeface</string>
    <string name="settings_text_size">Text size</string>
    <string name="settings_text_size_small">Small</string>
